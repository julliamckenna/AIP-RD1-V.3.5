# Copy to .env and fill in. Keep .env private: it identifies your Foundry project. The workflow runs on your
# machine; only Prompt Agent calls go to the Foundry project.

FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project-name>

# Authentication for Foundry Prompt Agent calls: entra (DefaultAzureCredential) or api_key.
FOUNDRY_AUTH_MODE=entra
# Required only when FOUNDRY_AUTH_MODE=api_key.
FOUNDRY_PROJECT_API_KEY=

# Prompt Agent names and desired model deployments. Run scripts/sync_prompt_agents.py --apply
# to create immutable versions, then pin the reported version values below.
FOUNDRY_AGENT_00_NAME=agent00-discovery
FOUNDRY_MODEL_DEPLOYMENT_NAME_AGENT_00=gpt-5.6-sol
FOUNDRY_AGENT_00_VERSION=6
FOUNDRY_AGENT_01_NAME=agent01-structure
FOUNDRY_MODEL_DEPLOYMENT_NAME_AGENT_01=gpt-5.6-sol
FOUNDRY_AGENT_01_VERSION=5
FOUNDRY_AGENT_02_NAME=agent02-calibration
FOUNDRY_MODEL_DEPLOYMENT_NAME_AGENT_02=gpt-5.6-luna
FOUNDRY_AGENT_02_VERSION=4
FOUNDRY_AGENT_03_NAME=agent03-extraction
FOUNDRY_MODEL_DEPLOYMENT_NAME_AGENT_03=gpt-5.6-luna
FOUNDRY_AGENT_03_VERSION=4
FOUNDRY_AGENT_04_NAME=agent04-qa
FOUNDRY_MODEL_DEPLOYMENT_NAME_AGENT_04=gpt-5.6-sol
FOUNDRY_AGENT_04_VERSION=4

# Where results are written locally (default: artifacts/runs inside this folder).
# Example: CHART_EXTRACT_OUTPUT_DIR=C:/Users/<you>/OneDrive/chart-runs
CHART_EXTRACT_OUTPUT_DIR=
# Where the review page's corrections are saved (default: artifacts/reviews).
CHART_EXTRACT_REVIEWS_DIR=

# 1 = answer every agent step with its examples/<step>.example.json (no Azure calls; wiring/preview only).
CHART_EXTRACT_DRY_RUN=0
